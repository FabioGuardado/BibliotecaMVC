@using BibliotecaMVC.Models
@model Autor

@{
    ViewData["Title"] = "Detalles del Autor";
}

<h1>@Model.Nombre @Model.Apellido</h1>

<dl class="row">
    <dt>Nacionalidad</dt>
    <dd>@Model.Nacionalidad</dd>

    <dt>Fecha de Nacimiento</dt>
    <dd>@Model.FechaNacimiento.ToString("yyyy-MM-dd")</dd>

    <dt>Edad</dt>
    <dd>@(DateTime.Now.Year - Model.FechaNacimiento.Year) años</dd>
</dl>

<a asp-action="Index" class="btn btn-primary">Volver al listado</a>