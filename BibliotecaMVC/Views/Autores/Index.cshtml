@using BibliotecaMVC.Models
@model IEnumerable<Autor>

@{
    ViewData["Title"] = "Listado de Autores";
}

<h1>@ViewData["Title"]</h1>
<p>Hay @Model.Count() autores registrados.</p>

@if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Bibliotecario))
{
    <div class="d-flex gap-2 mb-4">
        <a class="btn btn-outline-danger" asp-action="Reporte" target="_blank" rel="noopener">
            Abrir reporte
        </a>

        <a class="btn btn-danger" asp-action="DescargarReporte" target="_blank" rel="noopener">
            Descargar PDF
        </a>

        <a asp-action="Create" class="btn btn-primary">Nuevo Autor +</a>
    </div>
}

<div class="row">
    @foreach (var autor in Model)
    {
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@autor.Nombre @autor.Apellido</h5>
                    <div class="d-flex flex-row row-gap-4 justify-content-between">
                        <div>
                            <h6>Nacionalidad: @autor.Nacionalidad</h6>
                            <p>Edad: @(DateTime.Now.Year - autor.FechaNacimiento.Year) años</p>
                        </div>

                        <div class="d-flex flex-row gap-2 justify-content-start align-items-end">
                            <a asp-action="Details" asp-route-id="@autor.ID">Ver</a>
                            @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Bibliotecario))
                            {
                                <a asp-action="Edit" asp-route-id="@autor.ID" class="swal-edit-link">Editar</a>
                            }
                            @if (User.IsInRole(Roles.Admin))
                            {

                                <form asp-action="Delete" asp-route-id="@autor.ID" method="post" class="d-inline swal-delete-form">
                                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>