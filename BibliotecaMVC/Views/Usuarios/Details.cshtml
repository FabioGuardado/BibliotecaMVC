@using BibliotecaMVC.Models
@model UsuarioViewModel

@{
    ViewData["Title"] = "Detalles del Usuario";
}

<h1>@Model.UserName</h1>

<dl class="row">
    <dt>Correo electrónico</dt>
    <dd>@Model.Email</dd>

    <dt>Rol</dt>
    <dd>@Model.Rol</dd>
</dl>

<a asp-action="Index" class="btn btn-primary">Volver al listado</a>
