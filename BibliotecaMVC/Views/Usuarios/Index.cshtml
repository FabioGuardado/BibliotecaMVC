@using BibliotecaMVC.Models
@model IEnumerable<UsuarioViewModel>

@{
    ViewData["Title"] = "Listado de Usuarios";
}

<h1>@ViewData["Title"]</h1>
<p>Hay @Model.Count() usuarios registrados.</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (User.IsInRole(Roles.Admin))
{
    <a asp-action="Create" class="btn btn-primary mb-4">Nuevo Usuario +</a>
}

<div class="row">
    @foreach (var usuario in Model)
    {
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@usuario.UserName</h5>
                    <div class="d-flex flex-row row-gap-4 justify-content-between">
                        <div>
                            <h6>Correo: @usuario.Email</h6>
                            <p>Rol: @usuario.Rol</p>
                        </div>

                        <div class="d-flex flex-row gap-2 justify-content-start align-items-end">
                            <a asp-action="Details" asp-route-id="@usuario.Id">Ver</a>
                            @if (User.IsInRole(Roles.Admin))
                            {
                                <a asp-action="Edit" asp-route-id="@usuario.Id" class="swal-edit-link">Editar</a>

                                <form asp-action="Delete" asp-route-id="@usuario.Id" method="post" class="d-inline swal-delete-form">
                                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
