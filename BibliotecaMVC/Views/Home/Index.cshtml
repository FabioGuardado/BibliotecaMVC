<div class="container mt-5">
    <div class="row align-items-center gap-3 gap-lg-0">
        <div class="col-lg-6">
            <h1 class="display-4">BibliotecaMVC</h1>

            <p class="lead">
                Lorem Ipsum is simply dummy text of the printing and typesetting industry.
                Lorem Ipsum has been the industry's standard dummy text ever since 1966, when designers at Letraset and James Mosley,
                the librarian at St Bride Printing Library in London, took a 1914 Cicero translation and scrambled it to make dummy text for Letraset's Body Type sheets.
                It has survived not only many decades, but also the leap into electronic typesetting, remaining essentially unchanged.
                It was popularised thanks to these sheets and more recently with desktop publishing software
                like Aldus PageMaker and Microsoft Word including versions of Lorem Ipsum.
            </p>
            <a asp-controller="Home" asp-action="About" class="btn btn-primary">Conocer más</a>
        </div>
        <div class="col-lg-6 text-center">
            <div id="carouselExample" class="carousel slide">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="https://picsum.photos/500/350" alt="Biblioteca" class="d-block w-100 img-fluid rounded" />
                    </div>
                    <div class="carousel-item">
                        <img src="https://picsum.photos/500/350" alt="Biblioteca" class="d-block w-100 img-fluid rounded" />
                    </div>
                    <div class="carousel-item">
                        <img src="https://picsum.photos/500/350" alt="Biblioteca" class="d-block w-100 img-fluid rounded" />
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="bento-section">
    <h2 class="text-center mb-4">Servicios</h2>
    <div class="bento-container">
        @await Html.PartialAsync("_ServiceCard", new ServiceCard { ImageUrl = "https://picsum.photos/200/100", Text = "Servicio 1", customClasses = "bento-item-4x2" })
        @await Html.PartialAsync("_ServiceCard", new ServiceCard { ImageUrl = "https://picsum.photos/200/100", Text = "Servicio 2", customClasses = "bento-item-1x1" })
        @await Html.PartialAsync("_ServiceCard", new ServiceCard { ImageUrl = "https://picsum.photos/200/100", Text = "Servicio 3", customClasses = "bento-item-3x1" })
        @await Html.PartialAsync("_ServiceCard", new ServiceCard { ImageUrl = "https://picsum.photos/200/100", Text = "Servicio 4", customClasses = "bento-item-3x1" })
        @await Html.PartialAsync("_ServiceCard", new ServiceCard { ImageUrl = "https://picsum.photos/200/100", Text = "Servicio 5", customClasses = "bento-item-1x1" })
    </div>
</div>

@await Html.PartialAsync("_Counters", new CountersViewModel
{
    Counters = [
            new CounterItemViewModel { Id = 1, Header = "500+", Description = "Libros disponibles" },
            new CounterItemViewModel { Id = 2, Header = "120+", Description = "Autores registrados" },
            new CounterItemViewModel { Id = 3, Header = "25+", Description = "Categorías literarias" }
        ]
})

